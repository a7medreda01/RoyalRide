{
  "version": 2,
  "name": "royalride-angular",
  "builds": [
    {
      "src": "dist/royalride-angular/**",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/royalride-angular"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/royalride-angular/$1"
    }
  ]
}
